<Window x:Class="ResxStudio.Views.AutofillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fill missing translations"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="22,20,22,18">

        <TextBlock Text="Translate into" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <WrapPanel x:Name="LanguagesPanel"/>

        <TextBlock Text="Which keys" FontWeight="SemiBold" Margin="0,12,0,8"/>
        <WrapPanel>
            <RadioButton x:Name="ScopeView" Content="Keys in the current view" GroupName="Scope" Margin="0,0,18,6"/>
            <RadioButton x:Name="ScopeAll" Content="All keys" GroupName="Scope" Margin="0,0,18,6"/>
            <RadioButton x:Name="ScopeSelected" Content="Selected key only" GroupName="Scope" Margin="0,0,0,6"/>
        </WrapPanel>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Default file language" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="SourceBox" Style="{StaticResource Field}" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Your email (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource Field}"/>
            </StackPanel>
        </Grid>
        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                   Text="MyMemory's free limit is 5,000 characters a day, or 50,000 with an email address. The address is only sent to MyMemory."/>

        <TextBlock Text="Never translate" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <TextBox x:Name="TermsBox" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="72" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                   Text="One name per line, such as product and company names. Placeholders like {0}, HTML tags, Razor expressions, URLs and escapes like \n are always kept exactly as they are."/>

        <Border Margin="0,16,0,0" Padding="12,10" Background="{StaticResource CanvasBrush}" CornerRadius="6">
            <TextBlock x:Name="EstimateText" TextWrapping="Wrap"/>
        </Border>

        <ProgressBar x:Name="RunProgress" Style="{StaticResource ThinProgress}" Height="4" Margin="0,14,0,0"/>
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="LogBox" Style="{StaticResource Field}" IsReadOnly="True" Height="96" Margin="0,8,0,0"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Visibility="Collapsed"/>

        <DockPanel Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CloseButton" Content="Close"/>
                <Button x:Name="StartButton" Content="Start" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"
                       Text="Text is sent to MyMemory (translated.net), a public translation service. Results are marked for review."/>
        </DockPanel>
    </StackPanel>
</Window>
