<Window x:Class="ResxStudio.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="LabelText" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Style="{StaticResource Field}" FontFamily="{StaticResource MonoFont}"
                 TextChanged="OnTextChanged"/>
        <TextBlock x:Name="MessageText" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
