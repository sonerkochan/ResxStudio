<Window x:Class="ResxStudio.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="22,20,22,18">

        <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="15"/>
        <TextBlock Text="Choose how ResxStudio looks, then click Apply."
                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

        <RadioButton x:Name="LightOption" GroupName="Theme" Tag="Light" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Light"/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="DarkOption" GroupName="Theme" Tag="Dark" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Dark"/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SystemOption" GroupName="Theme" Tag="System">
            <StackPanel>
                <TextBlock Text="Use system setting"/>
                <TextBlock Text="Follows Windows, and switches when Windows does."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" MinWidth="90"
                    IsDefault="True" IsEnabled="False" Click="OnApply"/>
            <Button Content="Close" IsCancel="True" MinWidth="90" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
