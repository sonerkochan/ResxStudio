<Window x:Class="ResxStudio.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20"/>
        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
