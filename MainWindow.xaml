<Window x:Class="ResxStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1440" Height="880" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDrop="OnPreviewDrop"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding AddKeyCommand}"/>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RenameKeyCommand}"/>
        <KeyBinding Key="F8" Command="{Binding NextMissingCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Open…" Command="{Binding OpenCommand}" ToolTip="Open a .resx file and its languages (Ctrl+O)"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Save every changed file (Ctrl+S)"/>
                    <Rectangle Width="1" Fill="{StaticResource LineBrush}" Margin="6,2,12,2"/>
                    <Button Content="Add key" Command="{Binding AddKeyCommand}" ToolTip="Add a key to the default file (Ctrl+N)"/>
                    <Button Content="Add language" Command="{Binding AddLanguageCommand}" ToolTip="Create a new language file next to the others"/>
                    <Button Content="Next untranslated" Command="{Binding NextMissingCommand}" ToolTip="Jump to the next key with missing text (F8)"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="18,0" MaxWidth="560" HorizontalAlignment="Stretch">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Search keys and text in every language (Ctrl+F)"
                               Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}"/>
                </Grid>

                <CheckBox Grid.Column="2" Content="Untranslated only" VerticalAlignment="Center"
                          IsChecked="{Binding ShowMissingOnly}"
                          ToolTip="Show only keys with missing text in the visible languages"/>
            </Grid>
        </Border>

        <!-- Language chips: progress per language, click to show or hide a column -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding IsProjectLoaded, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Languages" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ItemsControl ItemsSource="{Binding Languages}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource LanguageChip}" IsChecked="{Binding IsVisible}"
                                          ToolTip="{Binding ProgressTooltip}">
                                <StackPanel MinWidth="112">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                                   Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,6,0"
                                                 Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                 ToolTip="Unsaved changes"
                                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding ChipName}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,6,0,0"
                                                 Value="{Binding Progress, Mode=OneWay}"/>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStateText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding FolderText}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <!-- Workspace -->
            <Grid Visibility="{Binding IsProjectLoaded, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" MinWidth="150"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="420" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <!-- Sections -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sections" Foreground="{StaticResource MutedBrush}" Margin="14,12,14,6"/>
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                 Style="{StaticResource SideList}" ItemContainerStyle="{StaticResource SideListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource MissingPill}" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Keys with missing text in the visible languages"
                                                Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding MissingCount}" Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Keys grid; language columns are added in code because their number varies -->
                <DataGrid x:Name="EntriesGrid" Grid.Column="1"
                          Style="{StaticResource EntriesGridStyle}"
                          ItemsSource="{Binding EntriesView}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          LostKeyboardFocus="OnGridLostKeyboardFocus">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteKeyCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rename key…" Command="{Binding RenameKeyCommand}" InputGestureText="Ctrl+R"/>
                            <MenuItem Header="Delete key" Command="{Binding DeleteKeyCommand}" InputGestureText="Del"/>
                            <Separator/>
                            <MenuItem Header="Copy key name" Click="OnCopyKey"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="{StaticResource LineBrush}"/>

                <!-- Editor panel for the selected key -->
                <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <TextBlock Text="Select a key to edit its text in every language."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                   Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVis}}"/>

                        <DockPanel Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVis}}">
                            <StackPanel DockPanel.Dock="Top" Margin="18,16,18,12">
                                <TextBlock Text="{Binding SelectedEntry.Key}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                                           Text="This key is missing from the default file, so the app has no fallback text for it. Add default text or rename it to the key you meant."
                                           Visibility="{Binding SelectedEntry.IsOrphan, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Rename…" Command="{Binding RenameKeyCommand}"/>
                                    <Button Content="Delete" Command="{Binding DeleteKeyCommand}" Style="{StaticResource DangerButton}"/>
                                </StackPanel>
                            </StackPanel>
                            <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource LineBrush}"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CellsList" ItemsSource="{Binding SelectedCells}" Margin="18,14,18,18" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16">
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right" Content="Copy default text"
                                                            Style="{StaticResource LinkButton}"
                                                            Command="{Binding CopyFromDefaultCommand}"
                                                            ToolTip="Use the default text as-is, for names and brands that don't change"
                                                            Visibility="{Binding Language.IsNeutral, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Language.Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource MissingPill}" Margin="8,0,0,0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Missing" Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBox Style="{StaticResource EditorField}"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding IsProjectLoaded, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Open your default .resx file" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Margin="0,10,0,22" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Text="Pick a file like Translations.resx and every language file next to it, such as Translations_bg.resx, opens side by side. You can also drop the file onto this window."/>
                <Button Content="Open .resx file…" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Padding="18,8" Margin="0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
