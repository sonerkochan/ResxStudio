<Window x:Class="ResxStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1480" Height="900" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDrop="OnPreviewDrop"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding AddKeyCommand}"/>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RenameKeyCommand}"/>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding AutofillCommand}"/>
        <KeyBinding Key="F8" Command="{Binding NextMissingCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Open…" Command="{Binding OpenCommand}" ToolTip="Open a .resx file and its languages (Ctrl+O)"/>
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Save every changed file (Ctrl+S)"/>
                    <Rectangle Width="1" Fill="{StaticResource LineBrush}" Margin="6,2,12,2"/>
                    <Button Content="Add key" Command="{Binding AddKeyCommand}" ToolTip="Add a key to the default file (Ctrl+N)"/>
                    <Button Content="Add language" Command="{Binding AddLanguageCommand}" ToolTip="Create a new language file next to the others"/>
                    <Button Content="Autofill missing…" Command="{Binding AutofillCommand}" ToolTip="Fill missing translations with free machine translation (Ctrl+T)"/>
                    <Button Content="Next untranslated" Command="{Binding NextMissingCommand}" ToolTip="Jump to the next key with missing text (F8)"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="18,0,12,0" MaxWidth="520">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Search keys and text (Ctrl+F)"
                               Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}"/>
                </Grid>

                <ComboBox Grid.Column="2" Width="200" VerticalAlignment="Center" Margin="0,0,10,0" Padding="8,6"
                          ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                          DisplayMemberPath="Label" ToolTip="Show only some keys"/>

                <ToggleButton Grid.Column="3" Style="{StaticResource ToolbarToggle}"
                              Content="{Binding ProblemsButtonText}" IsChecked="{Binding ShowProblems}"
                              ToolTip="Placeholder, format and key problems"/>
            </Grid>
        </Border>

        <!-- Language chips: progress per language, click to show or hide a column -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding IsProjectLoaded, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Languages" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ItemsControl ItemsSource="{Binding Languages}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource LanguageChip}" IsChecked="{Binding IsVisible}"
                                          ToolTip="{Binding ProgressTooltip}">
                                <StackPanel MinWidth="112">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                                   Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,6,0"
                                                 Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                 ToolTip="Unsaved changes"
                                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding ChipName}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource ThinProgress}" Margin="0,6,0,0"
                                                 Value="{Binding Progress, Mode=OneWay}"/>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Banner: a file changed outside the editor -->
        <Border DockPanel.Dock="Top" Background="{StaticResource NoticeBrush}"
                BorderBrush="{StaticResource NoticeBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding ExternalChangeMessage, Converter={StaticResource NotNullToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="Reload" Command="{Binding ReloadCommand}"/>
                    <Button Content="Dismiss" Command="{Binding DismissExternalChangeCommand}" Margin="0"/>
                </StackPanel>
                <TextBlock Text="{Binding ExternalChangeMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStateText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding FolderText}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <!-- Workspace -->
            <Grid Visibility="{Binding IsProjectLoaded, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" MinWidth="150"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="420" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <!-- Sections -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sections" Foreground="{StaticResource MutedBrush}" Margin="14,12,14,6"/>
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                 Style="{StaticResource SideList}" ItemContainerStyle="{StaticResource SideListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource MissingPill}" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Keys with missing text in the visible languages"
                                                Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding MissingCount}" Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Keys grid on top, Problems list underneath -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ProblemsRow" Height="0"/>
                    </Grid.RowDefinitions>

                    <!-- Language columns are added in code because their number varies -->
                    <DataGrid x:Name="EntriesGrid"
                              Style="{StaticResource EntriesGridStyle}"
                              ItemsSource="{Binding EntriesView}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              LostKeyboardFocus="OnGridLostKeyboardFocus">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteKeyCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename key…" Command="{Binding RenameKeyCommand}" InputGestureText="Ctrl+R"/>
                                <MenuItem Header="Delete key" Command="{Binding DeleteKeyCommand}" InputGestureText="Del"/>
                                <Separator/>
                                <MenuItem Header="Copy key name" Click="OnCopyKey"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <GridSplitter x:Name="ProblemsSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="{StaticResource LineBrush}" Visibility="Collapsed"/>

                    <DockPanel Grid.Row="2" Background="{StaticResource SurfaceBrush}">
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource LinkButton}"
                                        Command="{Binding HideProblemsCommand}"/>
                                <TextBlock Text="Problems" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ProblemSummary}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="270"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                                <ListBox ItemsSource="{Binding ProblemCategories}" SelectedItem="{Binding SelectedCategory}"
                                         Style="{StaticResource SideList}" ItemContainerStyle="{StaticResource SideListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Style="{StaticResource SeverityDot}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat=N0}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <ListBox Grid.Column="1" ItemsSource="{Binding VisibleIssues}" SelectedItem="{Binding SelectedIssue}"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource IssueItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Message}">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" Width="280" Margin="0,0,12,0"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Location}" Width="150" Margin="0,0,12,0"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Grid>

                <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="{StaticResource LineBrush}"/>

                <!-- Editor panel for the selected key -->
                <Border Grid.Column="3" Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <TextBlock Text="Select a key to edit its text in every language."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                   Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVis}}"/>

                        <DockPanel Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVis}}">
                            <StackPanel DockPanel.Dock="Top" Margin="18,16,18,12">
                                <TextBlock Text="{Binding SelectedEntry.Key}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                                           Text="This key is missing from the default file, so the app has no fallback text for it. Add default text or rename it to the key you meant."
                                           Visibility="{Binding SelectedEntry.IsOrphan, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Rename…" Command="{Binding RenameKeyCommand}"/>
                                    <Button Content="Delete" Command="{Binding DeleteKeyCommand}" Style="{StaticResource DangerButton}"/>
                                </StackPanel>
                            </StackPanel>
                            <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource LineBrush}"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CellsList" ItemsSource="{Binding SelectedCells}" Margin="18,14,18,18" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16">
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right" Content="Copy default text"
                                                            Style="{StaticResource LinkButton}"
                                                            Command="{Binding CopyFromDefaultCommand}"
                                                            ToolTip="Use the default text as-is, for names and brands that don't change"
                                                            Visibility="{Binding Language.IsNeutral, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <Button DockPanel.Dock="Right" Content="Mark reviewed" Margin="0,0,14,0"
                                                            Style="{StaticResource LinkButton}"
                                                            Command="{Binding MarkReviewedCommand}"
                                                            ToolTip="Keep this machine translation and remove the amber mark"
                                                            Visibility="{Binding IsMachineTranslated, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Language.Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Border Style="{StaticResource MissingPill}"
                                                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Missing" Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                                                        </Border>
                                                        <Border Style="{StaticResource MachinePill}"
                                                                ToolTip="Filled by machine translation. Edit it or mark it reviewed."
                                                                Visibility="{Binding IsMachineTranslated, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Auto-translated" Foreground="{StaticResource WarnBrush}" FontSize="11"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBox Style="{StaticResource EditorField}"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Text="{Binding ProblemText}"
                                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProblemIsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource NoticeBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,24"
                        Visibility="{Binding StartupNotice, Converter={StaticResource NotNullToVis}}">
                    <TextBlock Text="{Binding StartupNotice}" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Open your default .resx file" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Margin="0,10,0,22" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Text="Pick a file like Translations.resx and every language file next to it, such as Translations_bg.resx, opens side by side. You can also drop the file onto this window."/>
                <Button Content="Open .resx file…" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Padding="18,8" Margin="0"/>
                <TextBlock Margin="0,18,0,0" TextAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="Tip: hold Shift while starting ResxStudio to skip reopening the last file."/>
            </StackPanel>

            <!-- Loading -->
            <Border Background="{StaticResource CanvasBrush}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                    <TextBlock Text="{Binding LoadingText}" FontSize="16" TextAlignment="Center" Margin="0,0,0,12"/>
                    <ProgressBar IsIndeterminate="True" Height="3"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
